/* ============================================================
   CineShelf Dark Theme
   ============================================================ */

/* --- Global ------------------------------------------------- */

* {
    font-family: "Segoe UI", "Noto Sans", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #E8E8E8;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #0D0D0D;
}

QDialog {
    background-color: #161616;
}

/* --- Scrollbars --------------------------------------------- */

QScrollBar:vertical {
    background: #1A1A1A;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #3A3A3A;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #E50914;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1A1A1A;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #3A3A3A;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #E50914;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Buttons ------------------------------------------------ */

QPushButton {
    background-color: #1E1E1E;
    color: #E8E8E8;
    border: 1px solid #2E2E2E;
    border-radius: 5px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #2A2A2A;
    border-color: #E50914;
}

QPushButton:pressed {
    background-color: #E50914;
    color: #FFFFFF;
}

QPushButton:disabled {
    color: #555;
    background-color: #1A1A1A;
    border-color: #2A2A2A;
}

QPushButton#primary_btn {
    background-color: #E50914;
    border: none;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primary_btn:hover {
    background-color: #FF1925;
}

QPushButton#icon_btn {
    background: transparent;
    border: none;
    border-radius: 18px;
    padding: 4px;
    font-size: 16px;
}

QPushButton#icon_btn:hover {
    background: rgba(255,255,255,0.08);
}

/* --- Line edit --------------------------------------------- */

QLineEdit {
    background-color: #1E1E1E;
    border: 1px solid #2E2E2E;
    border-radius: 5px;
    padding: 6px 10px;
    color: #E8E8E8;
}

QLineEdit:focus {
    border-color: #E50914;
}

/* --- Labels ------------------------------------------------ */

QLabel {
    background: transparent;
}

QLabel#title_label {
    font-size: 26px;
    font-weight: 700;
    color: #E50914;
    letter-spacing: 2px;
}

QLabel#section_label {
    font-size: 16px;
    font-weight: 600;
    color: #CCCCCC;
}

/* --- Sliders ----------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #2E2E2E;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #E50914;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    background: #FFFFFF;
    border-radius: 7px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background: #E50914;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

/* --- Menus ------------------------------------------------- */

QMenu {
    background-color: #1A1A1A;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E50914;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #2E2E2E;
    margin: 4px 8px;
}

/* --- Combo box --------------------------------------------- */

QComboBox {
    background-color: #1E1E1E;
    border: 1px solid #2E2E2E;
    border-radius: 5px;
    padding: 5px 10px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #E50914;
}

QComboBox QAbstractItemView {
    background: #1A1A1A;
    border: 1px solid #2E2E2E;
    selection-background-color: #E50914;
}

/* --- Tooltip ----------------------------------------------- */

QToolTip {
    background: #1A1A1A;
    color: #E8E8E8;
    border: 1px solid #2E2E2E;
    padding: 4px 8px;
    border-radius: 4px;
}

/* --- Video card ------------------------------------------- */

QFrame#video_card {
    background-color: #151515;
    border: 1px solid #222222;
    border-radius: 8px;
}

QFrame#video_card:hover {
    border-color: #E50914;
    background-color: #1C1C1C;
}

/* --- Sidebar ---------------------------------------------- */

QFrame#sidebar {
    background-color: #111111;
    border-right: 1px solid #1F1F1F;
}

QPushButton#sidebar_btn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
    color: #AAAAAA;
    font-size: 13px;
}

QPushButton#sidebar_btn:hover {
    background: #1D1D1D;
    color: #FFFFFF;
}

QPushButton#sidebar_btn[active="true"] {
    background: #1D1D1D;
    color: #E50914;
    font-weight: 600;
    border-left: 3px solid #E50914;
}

/* --- Control bar ------------------------------------------ */

QFrame#control_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:1 rgba(0,0,0,0.88));
    border: none;
}

/* --- Progress bar ----------------------------------------- */

QSlider#seek_bar::groove:horizontal {
    height: 5px;
    background: rgba(255,255,255,0.15);
    border-radius: 2px;
}

QSlider#seek_bar::sub-page:horizontal {
    background: #E50914;
    border-radius: 2px;
}

QSlider#seek_bar::handle:horizontal {
    width: 14px;
    height: 14px;
    background: #FFFFFF;
    border-radius: 7px;
    margin: -5px 0;
}

/* --- Message box ------------------------------------------ */

QMessageBox {
    background-color: #161616;
}

QMessageBox QPushButton {
    min-width: 80px;
}
